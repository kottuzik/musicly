# Supabase — DEVELOPMENT project only. Never put Production values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Development). Used by scripts, tests and the server-side
# registration from an invitation link. Never in browser code.
SUPABASE_SECRET_KEY=
# Base URL of the app, used in password-reset email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail (Resend). Server-only. Without these, e-mail just waits in the outbox.
RESEND_API_KEY=
# Sender address, e.g. "Musicly <onboarding@resend.dev>" until a school domain is verified
EMAIL_FROM=
# "test" (default): only addresses in EMAIL_TEST_RECIPIENTS receive e-mail. "live" works only on Vercel Production.
EMAIL_MODE=test
# Comma-separated test addresses (Development), e.g. the address your Resend account was created with
EMAIL_TEST_RECIPIENTS=
# Shared secret that lets Supabase Cron call /api/cron/email (same value is stored in Supabase Vault as cron_secret)
CRON_SECRET=
# AI assistant (OpenAI). Server-only. Without a key the assistant screen says it is not set up yet.
OPENAI_API_KEY=
# Model name, e.g. gpt-4o-mini (default if empty)
OPENAI_MODEL=
# Optional: per-admin requests per hour and school-wide requests per day
AI_HOURLY_LIMIT=20
AI_DAILY_LIMIT=300
